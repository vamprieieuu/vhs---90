#include <windows.h>
#include "VHS90TextEditorResource.h"

IDD_VHS90_OSD_TEXT_EDITOR DIALOGEX 0, 0, 300, 145
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "VHS-90 OSD Text"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Enter OSD text (Arabic / English):", -1, 8, 8, 284, 12
    EDITTEXT IDC_VHS90_OSD_TEXT_EDIT, 8, 24, 284, 84, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    DEFPUSHBUTTON "OK", IDOK, 184, 120, 50, 16
    PUSHBUTTON "Cancel", IDCANCEL, 240, 120, 52, 16
END
